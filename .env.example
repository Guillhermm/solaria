# Copy to .env and fill in. .env is ignored by git; never commit real values.

# Where the viewer loads tiles from, read by `next build` (and `next dev`).
# A root-relative path or an https URL. Default: /tiles (served from public/tiles).
# Once tiles live on R2, point it at the bucket's custom domain, e.g. https://tiles.example.com
TILE_BASE_URL=/tiles

# Cloudflare R2, read by `npm run sync-r2` (dry run by default, --apply to upload).
# Account ID: 32 hex characters, from the Cloudflare dashboard.
R2_ACCOUNT_ID=
# An R2 API token scoped to the bucket, with Object Read & Write.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Lowercase letters, digits and hyphens.
R2_BUCKET=

# Optional: build the static site with mock and staged content (never for production).
# SOLARIA_CONTENT=development
